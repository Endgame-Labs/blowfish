+// ---- TEMPORARY Round C39 dump hook (not to be merged; removed before done) ----
+type C39Row = (u32, u32, u32, u32, f32, f32, [f32; 5]); // seg, cluster, ordinal, row, d1, e1, estimates
+type C39Leaf = (u32, u32, u32, u32, u32, u32, u32, u32, [u64; 4], u32); // seg, cluster, rows, matching, blocks, hit, code bytes, codes in fragment, [blob start, blob end, codes start, codes end]
+#[derive(Default)]
+struct C39Acc {
+    rows: Vec<C39Row>,
+    leaves: Vec<C39Leaf>,
+}
+static C39_QUERY: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+fn c39_path() -> Option<std::path::PathBuf> {
+    std::env::var_os("BF_C39_DUMP").map(Into::into)
+}
+
+async fn c39_finish(
+    acc: Arc<std::sync::Mutex<C39Acc>>,
+    owner: BTreeMap<(usize, u32), usize>,
+    indexes: &BTreeMap<usize, Arc<Index<Reader>>>,
+    vector: &[f32],
+    k: usize,
+) -> Result<(), ApiError> {
+    use std::io::Write;
+    let Some(path) = c39_path() else { return Ok(()) };
+    let (rows, mut leaves) = {
+        let mut a = acc.lock().unwrap();
+        (std::mem::take(&mut a.rows), std::mem::take(&mut a.leaves))
+    };
+    leaves.sort_unstable();
+    let leaf_of = |seg: u32, cluster: u32| leaves.binary_search_by_key(&(seg, cluster), |l| (l.0, l.1)).unwrap();
+    let n = rows.len();
+    let top = |key: &dyn Fn(&C39Row) -> f32, m: usize| -> Vec<usize> {
+        let mut idx: Vec<usize> = (0..n).collect();
+        let m = m.min(n);
+        if m > 0 && m < n {
+            idx.select_nth_unstable_by(m - 1, |&a, &b| key(&rows[a]).total_cmp(&key(&rows[b])));
+        }
+        idx.truncate(m);
+        idx
+    };
+    let mut chosen: BTreeSet<usize> = BTreeSet::new();
+    let top256: usize = std::env::var("BF_C39_TOP256").ok().and_then(|v| v.parse().ok()).unwrap_or(1500);
+    chosen.extend(top(&|r| r.4 - r.5, 300));
+    chosen.extend(top(&|r| r.6[0], top256));
+    chosen.extend(top(&|r| r.4, 100));
+    let chosen: Vec<usize> = chosen.into_iter().collect();
+    let mut exact: Vec<f32> = vec![f32::NAN; chosen.len()];
+    if std::env::var_os("BF_C39_EXACT").is_some() && !chosen.is_empty() {
+        let mut per: BTreeMap<usize, Vec<(u32, u32)>> = BTreeMap::new();
+        for &i in &chosen {
+            let r = &rows[i];
+            let o = owner[&(r.0 as usize, r.1)];
+            per.entry(o).or_default().push((r.1, r.2));
+        }
+        let reads = per.into_iter().map(|(o, locs)| {
+            let (index, vector) = (indexes[&o].clone(), vector.to_vec());
+            async move {
+                let len = locs.len();
+                index.rerank_candidates(&vector, len, locs).await.map_err(segment::index_error)
+            }
+        });
+        let parts = futures::stream::iter(reads).buffer_unordered(64).try_collect::<Vec<_>>().await?;
+        let by_row: std::collections::HashMap<u32, f32> = parts.into_iter().flatten().collect();
+        for (slot, &i) in exact.iter_mut().zip(&chosen) {
+            if let Some(d) = by_row.get(&rows[i].3) {
+                *slot = *d;
+            }
+        }
+    }
+    let mut out: Vec<u8> = Vec::new();
+    let put = |out: &mut Vec<u8>, v: u32| out.extend(v.to_le_bytes());
+    put(&mut out, 0xC39);
+    put(&mut out, C39_QUERY.fetch_add(1, std::sync::atomic::Ordering::Relaxed));
+    put(&mut out, k as u32);
+    put(&mut out, n as u32);
+    put(&mut out, leaves.len() as u32);
+    put(&mut out, chosen.len() as u32);
+    for x in vector.iter().take(8) {
+        out.extend(x.to_le_bytes());
+    }
+    for l in &leaves {
+        for v in [l.0, l.1, l.2, l.3, l.4, l.5, l.6, l.7] {
+            put(&mut out, v);
+        }
+        for v in l.8 {
+            out.extend(v.to_le_bytes());
+        }
+        put(&mut out, l.9);
+    }
+    for r in &rows {
+        put(&mut out, leaf_of(r.0, r.1) as u32);
+    }
+    for r in &rows {
+        put(&mut out, r.2);
+    }
+    for r in &rows {
+        out.extend(r.4.to_le_bytes());
+    }
+    for r in &rows {
+        out.extend(r.5.to_le_bytes());
+    }
+    for e in 0..5 {
+        for r in &rows {
+            out.extend(r.6[e].to_le_bytes());
+        }
+    }
+    for &i in &chosen {
+        put(&mut out, i as u32);
+    }
+    for d in &exact {
+        out.extend(d.to_le_bytes());
+    }
+    let mut f = std::fs::OpenOptions::new().create(true).append(true).open(path).map_err(segment::index_error)?;
+    f.write_all(&out).map_err(segment::index_error)?;
+    Ok(())
+}
+// ---- end of the C39 hook ----
