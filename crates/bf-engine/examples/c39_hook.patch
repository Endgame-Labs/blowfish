+    /// TEMPORARY (Round C39, not to be merged): for the rows of one probed leaf passing `filter`,
+    /// the 1,024-bit RaBitQ estimate and error bound, and the estimate from only the first 256 code
+    /// bits (the 256-bit estimate scales the dot product by `padded / 256`). Returns
+    /// `(rows, matching, blocks, blocks with a match)`.
+    pub fn c39_dump_leaf(
+        &self,
+        query: &RotatedQuery,
+        cid: usize,
+        bytes: &[u8],
+        filter: Option<&RoaringBitmap>,
+        out: &mut Vec<(u32, u32, u32, f32, f32, [f32; 5])>,
+    ) -> Result<(usize, usize, usize, usize)> {
+        let c = &self.metadata.clusters[cid];
+        let n = c.len();
+        let padded = self.rq.padded;
+        let blk = crate::fastscan::BLOCK;
+        if n == 0 || bytes.len() != crate::fastscan::block_len(n, padded) {
+            return Ok((n, 0, n.div_ceil(blk), 0));
+        }
+        let ids: Vec<u32> = match c.ids.as_deref() {
+            Some(ids) => ids.to_vec(),
+            None => c.rows.iter().collect(),
+        };
+        let cosine = self.metric() == Metric::CosineDistance;
+        let (half, top) = if cosine { (0.5f32, 2f32) } else { (1f32, f32::INFINITY) };
+        let qc2 = crate::distance::l2_squared_f32(&query.rotated32, &c.center);
+        let root = (padded as f32).sqrt();
+        let spread = crate::rabitq::ERROR_CONFIDENCE as f32 * 2. * qc2.max(0.).sqrt()
+            / ((padded - 1).max(1) as f32).sqrt();
+        let (factors, codes) = bytes.split_at(16 * n);
+        let factor = |i: usize, r: usize| {
+            f32::from_le_bytes(factors[(i * n + r) * 4..(i * n + r) * 4 + 4].try_into().unwrap())
+        };
+        // Per code byte `t` and value `v`: the sum of b_i y_i over its eight dimensions.
+        let width = padded / 8;
+        let mut table = vec![0f32; width * 256];
+        for t in 0..width {
+            let y: Vec<f32> = (0..8)
+                .map(|i| (query.rotated[8 * t + i] - f64::from(c.center[8 * t + i])) as f32)
+                .collect();
+            for v in 0..256usize {
+                let mut s = 0f32;
+                for (i, yi) in y.iter().enumerate() {
+                    s += if v >> i & 1 == 1 { *yi } else { -*yi };
+                }
+                table[t * 256 + v] = s;
+            }
+        }
+        let stripe = width / 4;
+        let (mut matching, mut hit) = (0usize, std::collections::BTreeSet::new());
+        for r in 0..n {
+            let row = ids.get(r).copied().unwrap_or(u32::MAX);
+            if filter.is_some_and(|f| !f.contains(row)) {
+                continue;
+            }
+            matching += 1;
+            hit.insert(r / blk);
+            let block = &codes[r / blk * width * blk..][..width * blk];
+            let j = r % blk;
+            let (mut full, mut part) = (0f32, 0f32);
+            // Prefix sums at 128, 256, 384, and 512 bits.
+            let mut prefix = [0f32; 4];
+            for t in 0..width {
+                let s = table[t * 256 + block[t * blk + j] as usize];
+                full += s;
+                if t < stripe {
+                    part += s;
+                }
+                if t < width / 2 {
+                    prefix[t / (width / 8)] += s;
+                }
+            }
+            let (p128, p384, p512) = (prefix[0], prefix[0] + prefix[1] + prefix[2], prefix[0] + prefix[1] + prefix[2] + prefix[3]);
+            let (sq, signed_k, k2) = (factor(0, r), factor(1, r), factor(2, r));
+            let k = signed_k.abs();
+            let (d, e);
+            let mut est = [0f32; 5];
+            if signed_k.is_sign_negative() || query.zero {
+                d = if query.zero && signed_k.is_sign_negative() { 0. } else { 1. };
+                e = 0.;
+                est = [d; 5];
+            } else {
+                // The table sums are already against `q - c`, so no `cb` term.
+                let dist = |dot: f32| ((sq + qc2 - 2. * k * dot) * half).clamp(0., top);
+                d = dist(full / root);
+                e = spread * k2 * half;
+                // 256 bits scaled by 4 (unbiased), 256 bits unscaled, and 128, 384, and 512 bits scaled to 1,024.
+                est = [
+                    dist(part / root * 4.),
+                    dist(part / root),
+                    dist(p128 / root * 8.),
+                    dist(p384 / root * (8. / 3.)),
+                    dist(p512 / root * 2.),
+                ];
+            }
+            out.push((cid as u32, r as u32, row, d, e, est));
+        }
+        Ok((n, matching, n.div_ceil(blk), hit.len()))
+    }
